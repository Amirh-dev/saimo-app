
web.saimo.app {
	root * /srv/saimo-web/current
	encode zstd gzip

	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Flutter's build output keeps the same file names every release
		# (main.dart.wasm, main.dart.mjs, assets/...), so nothing may be
		# reused without asking first; an unchanged file is a cheap 304.
		Cache-Control "no-cache"
	}

	try_files {path} /index.html
	file_server
}
