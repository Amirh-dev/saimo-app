<?xml version="1.0" encoding="utf-8"?>
<!-- «امروز» (2×2): today's study against the plan, a capsule per task, the
     multiplier, and the task being studied. Every text is an image in
     IRANSans drawn by HomeWidgets (TextImages). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/today_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/widget_today_label"
            android:scaleType="fitEnd" />

        <include layout="@layout/widget_streak_pill" />

        <ImageView
            android:id="@+id/today_mark"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_mark" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- «۱۰۲ از ۲۰۰ دقیقه» -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/today_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/today_planned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="2dp" />
        </LinearLayout>

        <include
            layout="@layout/widget_capsules"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="24dp">

            <ImageView
                android:id="@+id/today_footer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center" />

            <!-- While a timer runs: the task, as a capsule that opens it. -->
            <LinearLayout
                android:id="@+id/today_capsule"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/widget_orange" />

                <ImageView
                    android:id="@+id/today_capsule_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/today_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="center"
        android:visibility="gone" />
</LinearLayout>
