<?xml version="1.0" encoding="utf-8"?>
<!-- A task's progress on «کارهای امروز». -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="@color/widget_bar_track" /><corners android:radius="2dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="@color/widget_orange" /><corners android:radius="2dp" /></shape></clip>
    </item>
</layer-list>
